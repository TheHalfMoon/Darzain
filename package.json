{
  "name": "darzain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node --watch server/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/main.ts",
    "test": "node --test tests/*.test.ts src/donors/film-editor/utils/*.test.ts",
    "typecheck": "tsc --noEmit",
    "cli": "node cli/main.ts",
    "lint": "oxlint --deny-warnings core server cli src/main.tsx src/adapter.ts tests scripts",
    "format": "prettier --write \"core/*.ts\" server cli src/main.tsx src/adapter.ts src/style.css tests scripts vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check \"core/*.ts\" server cli src/main.tsx src/adapter.ts src/style.css tests scripts vite.config.ts tsconfig.json package.json",
    "test:e2e": "node scripts/browser-e2e.mjs",
    "provenance:check": "node scripts/provenance.mjs",
    "benchmark": "node scripts/benchmark-production.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.87.0",
    "playwright-core": "1.64.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
